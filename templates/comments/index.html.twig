{% extends 'base.html.twig' %}

{% block title %}Forum {% endblock %}

{% block body %}
    <div class="container">
        <h1 class="text-center my-4">Forum</h1>

        <!-- Liste des Posts -->
        {% for post in forumPosts %}
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">{{ post.title }}</h5>
                    <p class="card-text">{{ post.content }}</p>
                    <p class="text-muted small">
                        Posté le {{ post.createdAt|date('d/m/Y H:i') }}
                        {% if post.updatedAt %}
                            | Dernière modification le {{ post.updatedAt|date('d/m/Y H:i') }}
                        {% endif %}
                    </p>
                   
                </div>

                <!-- Boutons Like et Commenter -->
                <div class="card-footer bg-transparent">
                    <div class="d-flex justify-content-between align-items-center">
                        <!-- Bouton Like -->
                        <a href="{{ path('app_forum_posts_like', {'id': post.id}) }}" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-thumbs-up"></i> J'aime
                        </a>
                        <span class="badge bg-secondary">{{ post.likes }} Likes</span>

                        <!-- Bouton Commenter -->
                        <button class="btn btn-outline-success btn-sm" data-bs-toggle="collapse" data-bs-target="#comments-{{ post.id }}">
                            <i class="fas fa-comment"></i> Commenter
                        </button>
                    </div>
                </div>

                <!-- Section des Commentaires (masquée par défaut) -->
                <div id="comments-{{ post.id }}" class="collapse">
                    <div class="card-body">
                        <h6>Commentaires :</h6>
                        {% if post.comments|length > 0 %}
                            <ul class="list-group list-group-flush">
                                {% for comment in post.comments %}
                                    <li class="list-group-item">
                                        <p>{{ comment.content }}</p>
                                        <small class="text-muted">
                                            Posté le {{ comment.createdAt|date('d/m/Y H:i') }}
                                            {% if comment.updatedAt %}
                                                | Modifié le {{ comment.updatedAt|date('d/m/Y H:i') }}
                                            {% endif %}
                                        </small>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p class="text-muted">Aucun commentaire pour le moment.</p>
     
                        {% endif %}


                        <!-- Formulaire pour ajouter un commentaire -->
                        <form action="{{ path('app_comments_new', {'postId': post.id}) }}" method="post" class="mt-3">
                           <!-- <div class="form-group">
                                <textarea name="content" class="form-control" rows="3" placeholder="Ajouter un commentaire..." required></textarea>
                            </div>-->
                            <button type="submit" class="btn btn-primary btn-sm mt-2">Commenter</button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                Aucun post trouvé.
            </div>
        {% endfor %}
    </div>
{% endblock %}