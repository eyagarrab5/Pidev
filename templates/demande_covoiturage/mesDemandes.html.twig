{% extends 'base.html.twig' %}

{% block title %}Demande de Covoiturage{% endblock %}

{% block body %}
    <div class="container mt-4">
   
<h5 style="text-align: center;  font-family: 'Poppins', sans-serif;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase; margin-bottom: 20px;">Voici vos demandes : vous pouvez les supprimer ou les modifier si vous le souhaitez.</h5>
        
        <div class="row">
            {% for demande_covoiturage in demande_covoiturages %}
                <div class="col-md-4 mb-4">
                    <div class="card border-light rounded-lg" style="border: 20px solid #007bff; transition: transform 0.3s ease-in-out;">
                      <div class="card-body bg-lightblue">
                            <h6 class="card-subtitle mb-2"> <strong>De {{ demande_covoiturage.depart }} à {{ demande_covoiturage.destination }} </strong></h6>
                            <p class="card-text">
                                <strong>Date:</strong> {{ demande_covoiturage.date ? demande_covoiturage.date|date('Y-m-d H:i:s') : 'Non spécifiée' }}<br>
                                <strong>Budget:</strong> {{ demande_covoiturage.budget }} dt<br>
                            </p>
                            <div class="d-flex justify-content-between">
                              <a href="{{ path('app_demande_covoiturage_edit', {'id': demande_covoiturage.id}) }}"
                                 style="background-color:white; color: #223366; padding: 1px; margin-left: 282px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                 <i class="fas fa-edit"></i>
                              </a>

                                {{ include('demande_covoiturage/_delete_form.html.twig') }}

                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p class="text-danger">Aucune demande trouvée.</p>
                </div>
            {% endfor %}
        </div>

       
    </div>

    <style>
        .card {
            border: 30px solid #007bff; 
            border-radius: 8px; 
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;
        }
         
    body {
        background-image: url('{{ asset('img/pic5.jpg') }}'); 
        background-size: cover; /* Couvrir toute la zone */
        background-position: center; /* Centrer l'image */
        background-repeat: no-repeat; /* Ne pas répéter l'image */
    }


        .card:hover {
            transform: translateY(-10px); /* Effet de déplacement */
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); /* Ombre accentuée au survol */
        }

        .card-body {
            padding: 20px; /* Ajout d'espace pour rendre la carte aérée */
        }

        .btn-primary, .btn-warning {
            transition: background-color 0.3s ease, transform 0.3s ease;
        }

        .btn-primary:hover, .btn-warning:hover {
            transform: scale(1.05);
            background-color: #0056b3;
        }

        .btn-warning:hover {
            background-color: #e0a800;
        }

        .text-danger {
            font-weight: bold;
        }
        .btn-custom {
    background-color:rgb(106, 218, 255);
    color: #333;
    font-size: 0.875rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    transition: background-color 0.3s ease, border-color 0.3s ease;
    margin-left:230px;
}

.btn-custom:hover {
    background-color:rgb(175, 223, 255);
    color: #222;
}
.bg-lightblue {
    background-color:rgb(254, 254, 254); /* Bleu clair */
}

    </style>
{% endblock %}



























































