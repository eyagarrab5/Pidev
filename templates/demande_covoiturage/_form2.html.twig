{% form_theme form 'bootstrap_5_layout.html.twig' %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adit</title>
    <style>
        /* Styles personnalisés pour améliorer l'apparence du formulaire */
        .form-container {
            max-width: 600px;
            margin: auto;
            background-color: #f8f9fa;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .form-container h2 {
            text-align: center;
            margin-bottom: 4px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            font-weight: bold;
            color: #495057;
        }

        .form-group input,
        .form-group select {
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
            width: 100%;
            padding: 0.5rem;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(38, 143, 255, 0.25);
        }

        button.btn {
            font-size: 1.125rem;
            font-weight: 600;
            background-color: #007bff;
            border-color: #007bff;
            color: white;
            padding: 0.75rem;
            width: 100%;
            border-radius: 0.375rem;
            transition: background-color 0.3s, border-color 0.3s;
        }

        button.btn:hover {
            background-color: #0056b3;
            border-color: #004085;
        }
    </style>
</head>
<body>

<div class="form-container container">
    <h2>Editer votre demande</h2>
    {{ form_start(form) }}
    
    <div class="form-group">
        {{ form_label(form.depart, 'Départ', {'attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.depart, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le lieu de départ'}}) }}
     <div class="text-danger">
                {{ form_errors(form.depart) }}
            </div>
    </div>
    <div class="form-group">
        {{ form_label(form.destination, 'Destination', {'attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.destination, {'attr': {'class': 'form-control', 'placeholder': 'Entrez la destination'}}) }}
     <div class="text-danger">
                {{ form_errors(form.depart) }}
            </div>
    </div>
    <div class="form-group">
        {{ form_label(form.date, 'Date', {'attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.date, {'attr': {'class': 'form-control', 'placeholder': 'Sélectionnez une date'}}) }}
     <div class="text-danger">
                {{ form_errors(form.depart) }}
            </div>
    </div>
    <div class="form-group">
        {{ form_label(form.budget, 'Budget', {'attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.budget, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre budget'}}) }}
     <div class="text-danger">
                {{ form_errors(form.depart) }}
            </div>  
    </div>
    <button type="submit" class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
    {{ form_end(form) }}
</div>
     <style>
    body {
        background-image: url('{{ asset('img/pic5.jpg') }}'); /* Définir le GIF comme arrière-plan */
        background-size: cover; /* Couvrir toute la zone */
        background-position: center; /* Centrer l'image */
        background-repeat: no-repeat; /* Ne pas répéter l'image */
    }
</style>
</body>
</html>
