{% extends 'base.html.twig' %}

{% block title %}Demandes de Covoiturage{% endblock %}

{% block body %}
<div class="container" style="margin-top: -4.5rem!important;">
    <div class="search-container text-center mb-4">
        <div class="input-group mx-auto" style="max-width: 300px;">
            <span class="input-group-text bg-white border-end-0">
                <i class="fas fa-search text-primary"></i>
            </span>
            <input type="text" class="form-control border-start-0" placeholder="Rechercher des demandes...">
        </div>
    </div>

    <div class="gif-container text-center mb-4">
        <h2 style="font-family: 'Poppins', sans-serif;">Des passagers en attente, à vous de jouer !</h2>
        <img src="{{ asset('img/gif.gif') }}" alt="GIF animée" class="rounded" style="max-width: 300px; height: auto;">
    </div>

    <div class="row" id="demandes-container">
        {% for demande_covoiturage in demande_covoiturages %}
            <div class="col-md-4 mb-4 demand-card" style="display: {% if loop.index > 6 %}none{% endif %};">
                <div class="card border-light rounded-lg">
                    <div class="card-body bg-lightblue">
                        <h5 class="card-title">Mohammed 2</h5>
                        <h6 class="card-subtitle">
                            <i class="fas fa-map-marker-alt"></i> De {{ demande_covoiturage.depart }} à {{ demande_covoiturage.destination }}
                        </h6>
                        <p class="card-text">
                            <i class="fas fa-calendar-alt text-primary"></i>
                            <strong>Date:</strong> {{ demande_covoiturage.date ? demande_covoiturage.date|date('Y-m-d H:i:s') : 'Non spécifiée' }}<br>
                            <i class="fas fa-wallet text-info"></i>
                            <strong>Budget:</strong> {{ demande_covoiturage.budget }} dt<br>
                        </p>
                        <div class="d-flex justify-content-between">
                            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#confirmationModal{{ demande_covoiturage.id }}">
                               Proposer
                            </button>
<button class="btn-favorite">
                            <i class="fas fa-heart"></i>
                        </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modale de confirmation -->
            <div class="modal fade" id="confirmationModal{{ demande_covoiturage.id }}" tabindex="-1" aria-labelledby="confirmationModalLabel{{ demande_covoiturage.id }}" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="confirmationModalLabel{{ demande_covoiturage.id }}">Confirmer la proposition</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <!-- Image ajoutée dans le modal -->
                            <img src="{{ asset('img/pic8.jpg') }}" alt="Image de confirmation" class="img-fluid mb-3" style="border-radius: 8px; width: 200px; display: block; margin: 0 auto;">
                            Êtes-vous sûr de vouloir proposer ce trajet de {{ demande_covoiturage.depart }} à {{ demande_covoiturage.destination }} le {{ demande_covoiturage.date|date('Y-m-d H:i:s')}} ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <a href="{{ path('app_proposition_covoiturage_new', {'id': demande_covoiturage.id}) }}" class="btn btn-primary">Confirmer</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center">
                <p class="text-danger">Aucune Demande trouvée.</p>
            </div>
        {% endfor %}
    </div>

    <div class="text-center mt-4">
        <button id="loadMore" class="btn btn-link">
            <i class="fas fa-arrow-down fa-2x"></i>
        </button>
    </div>
</div>

{% block javascripts %}
<script>
document.addEventListener("DOMContentLoaded", function () {
        let confirmBtn = document.getElementById("confirmBtn");

        document.querySelectorAll(".btn-propose").forEach(button => {
            button.addEventListener("click", function () {
                let id = this.getAttribute("data-id");
                confirmBtn.href = "{{ path('app_proposition_covoiturage_new', {'id': '__ID__'}) }}".replace("__ID__", id);
                document.body.classList.add("modal-open"); // Ajoute la classe pour l'effet de flou
            });
        });

        // Supprime l'effet de flou lorsque la modale est fermée
        document.getElementById("confirmationModal").addEventListener("hidden.bs.modal", function () {
            document.body.classList.remove("modal-open");
        });
    });
document.addEventListener('DOMContentLoaded', function () {
    const demandes = document.querySelectorAll('.demand-card');
    const loadMoreButton = document.getElementById('loadMore');
    let visibleCount = 6; // Nombre initial de demandes visibles

    loadMoreButton.addEventListener('click', function () {
        // Trouver les 6 prochaines demandes à afficher
        let nextDemandes = Array.from(demandes).slice(visibleCount, visibleCount + 6);
        nextDemandes.forEach(d => d.style.display = 'block');

        // Mettre à jour le compteur de demandes visibles
        visibleCount += nextDemandes.length;

        // Si toutes les demandes sont visibles, cacher le bouton
        if (visibleCount >= demandes.length) {
            loadMoreButton.style.display = 'none';
        }
    });
});
</script>
{% endblock %}

<style>
/* Add these styles to your existing CSS */
#loadMore {
    color: #007bff;
    transition: transform 0.3s ease;
}

#loadMore:hover {
    color: #0056b3;
    transform: translateY(3px);
}

/* ... (rest of your existing styles remain unchanged) ... */
body {
    background-image: url('{{ asset('img/pic5.jpg') }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    font-family: Arial, sans-serif;
    color: #333;
    margin: 0;
    padding: 0;
}

/* Conteneur GIF */
.gif-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    text-align: center;
    margin-bottom: 20px;
}

.gif-container img {
    max-width: 300px;
    height: auto;
    border-radius: 5%;
}

.gif-container span {
    font-size: 1.2rem;
    font-weight: bold;
    margin-top: 10px;
    color: #444;
}

/* Style des cadres (cartes) */
.card {
    border: 1px solid rgba(0, 123, 255, 0.3); /* Bordure douce */
    border-radius: 12px; /* Coins arrondis */
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1); /* Ombre légère */
    background-color: #ffffff; /* Fond blanc */
    overflow: hidden; /* Arrondi des contenus */
    transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out; /* Transitions fluides */
    margin-bottom: 20px;
}

.card:hover {
    transform: translateY(-8px); /* Légère élévation */
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2); /* Ombre marquée */
    border-color: rgba(0, 123, 255, 0.5); /* Accent de bordure */
}

.card-body {
    padding: 1.5rem; /* Espacement confortable */
}

/* Titres et texte dans les cadres */
.card-title {
    font-size: 1.2rem;
    font-weight: bold;
    color: #07005a; /* Bleu vif */
    margin-bottom: 8px;
}

.card-subtitle {
    font-size: 1.1rem;
    color: #6c757d; /* Gris subtil */
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px; /* Espace entre les icônes et le texte */

}

.card-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #333333; /* Noir doux */
}

/* Boutons personnalisés */
.btn-custom {
    display: inline-block;
    margin-top: 12px;
    padding: 10px 20px;
    background-color: rgb(245, 172, 0); /* Jaune doux */
    color: #333;
    font-weight: 600;
    text-transform: uppercase;
    border-radius: 8px;
    border: none;
    transition: background-color 0.3s ease, transform 0.2s ease;
}

.btn-custom:hover {
    background-color: #07005a; /* Bleu au survol */
    color: #fff;
    transform: scale(1.05); /* Mise en avant */
}

/* Modale */
.modal-backdrop.show {
    backdrop-filter: blur(5px); /* Flou d'arrière-plan */
    transition: backdrop-filter 0.3s ease;
}

.modal-header, .modal-footer {
    border: none; /* Suppression des bordures */
}

.modal-body img {
    border-radius: 8px;
    width: 200px;
    display: block;
    margin: 0 auto;
    margin-bottom: 15px;
}

/* Texte d'alerte */
.text-danger {
    font-weight: bold;
    font-size: 1rem;
    color: #dc3545; /* Rouge vif */
    margin-top: 20px;
}
.btn-favorite {
    background-color: transparent; /* Fond transparent */
    border: none; /* Pas de bordure pour le bouton */
    color: #dc3545; /* Couleur de la bordure du cœur */
    font-size: 1.5rem;
    cursor: pointer;
    padding: 6px; /* Espace interne */
    transition: transform 0.3s ease, color 0.3s ease;
}

.btn-favorite i {
    font-size: 1.5rem;
    color: transparent; /* Cœur transparent */
    -webkit-text-stroke: 1px #dc3545; /* Bordure rouge */
    transition: color 0.3s ease, transform 0.3s ease;
}

.btn-favorite:hover i {
    color: rgba(255, 77, 77, 0.3); /* Remplissage léger au survol */
    -webkit-text-stroke: 1px #fa4455; /* Bordure plus vive */
    transform: scale(1.1); /* Légère mise en avant */
}

.btn-favorite:focus {
    outline: none;
}

/* Style responsive */
@media (max-width: 768px) {
    .gif-container img {
        max-width: 200px; /* Réduction de la taille sur mobile */
    }

    .card-body {
        padding: 1rem; /* Espacement réduit */
    }

    .btn-custom {
        padding: 8px 16px;
        font-size: 0.875rem;
    }
}

</style>


<!-- Bootstrap JS (si pas déjà inclus dans base.html.twig) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}




