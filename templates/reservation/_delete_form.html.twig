<form method="post" action="{{ path('app_reservation_delete', {'id': reservation.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
    <button class="btn-delete">Delete</button>
    
{% block stylesheets %}
    <style>
        .btn-delete {
            background-color: #f5e089; /* Jaune */
            color: black;
            border: none;
            padding: 8px 16px;
            text-align: center;
            border-radius: 4px;
            font-size: 0.9rem;
            transition: background-color 0.3s ease;
        }

        .btn-delete:hover {
            background-color:rgb(240, 198, 29); /* Jaune foncé */
        }
    </style>
{% endblock %}
</form>
