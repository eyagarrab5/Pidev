{% extends 'base2.html.twig' %}

{% block title %}Reservation index{% endblock %}

{% block body %}
    <h1 style="color: #0044cc; text-align: center;">Liste de toutes les réservations disponibles !</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Id Passager</th>
                <th>Statut</th>
                <th>Id Offre</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.passagerId }}</td>
                <td>{{ reservation.statut.value }}</td>
                <td>{{ reservation.offre.id }}</td>
                <td>
                    {{ include('reservation/_delete_form_Admin.html.twig') }}
                </td>
            </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucune réservation trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
