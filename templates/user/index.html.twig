{% extends 'base2.html.twig' %}

{% block title %}Admin - Utilisateurs{% endblock %}

{% block body %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <div class="container mt-4">
        <h1 class="text-center text-primary mb-4">Administration - Utilisateurs</h1>

        <!-- Tableau des utilisateurs -->
        <table class="table table-striped table-hover table-bordered shadow-sm">
            <thead class="thead-dark">
                <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Rôle</th>
                    <th>Prénom</th>
                    <th>Nom</th>
                    <th>Téléphone</th>
                    <th>Véhicule</th>
                    <th>Vérifié</th>
                    <th>Banni</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.role }}</td>
                        <td>{{ user.firstName ?? '-' }}</td>
                        <td>{{ user.lastName ?? '-' }}</td>
                        <td>{{ user.telephone ?? '-' }}</td>
                        <td>{{ user.vehicule ?? '-' }}</td>
                        <td>
                            {% if user.verified %}
                                <span class="badge bg-success">Oui</span>
                            {% else %}
                                <span class="badge bg-danger">Non</span>
                            {% endif %}
                        </td>
                
                        <td>
                            <!-- Bouton Supprimer l'utilisateur -->
                            <form action="{{ path('user_delete', {'id': user.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> 
                                </button>
                            </form>

                            <!-- Bouton Modifier l'utilisateur -->
                            <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit"></i> 
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10" class="text-center">
                            <div class="alert alert-info" role="alert">
                                Aucun utilisateur trouvé.
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}