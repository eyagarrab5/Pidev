{% extends 'base2.html.twig' %}

{% block title %}Ajouter un commentaire{% endblock %}

{% block body %}
    <h1>Ajouter un commentaire au post : {{ forum_post.title }}</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary">Ajouter le commentaire</button>
    {{ form_end(form) }}

    <a href="{{ path('app_admin_forum_posts') }}" class="btn btn-secondary">Retour à la liste des posts</a>
{% endblock %}