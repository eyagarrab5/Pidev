{% extends 'base2.html.twig' %}

{% block title %}Ajouter un commentaire{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="text-center my-4">Ajouter un commentaire au post : {{ forum_post.title }}</h1>

        <div class="card">
            <div class="card-body">
              <!-- Colonne de gauche pour l'image -->
            <div class="col-md-4">
                <div class="text-center">
                    <img src="{{ asset('img/pic4.jpg') }}" alt="Image du forum" class="img-fluid rounded mb-4" style="max-width: 100%; height: auto;">
                </div>
            </div>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.content, 'Contenu du commentaire', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre commentaire...', 'rows': 4}}) }}
                    {{ form_errors(form.content) }}
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i>Commenter
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="mt-4">
            <a href="{{ path('app_admin_forum_posts') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>
    </div>
{% endblock %}