{% extends 'base2.html.twig' %}

{% block title %}Admin - Posts{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="text-center my-4">Administration des Posts</h1>

        <!-- Tableau des posts -->
        {% for forum_post in forum_posts %}
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">{{ forum_post.title }}</h5>
                    <p class="card-text">{{ forum_post.content }}</p>
                    <p class="text-muted small">
                        Posté par : {{ forum_post.user.firstName }} {{ forum_post.user.lastName }}
                        le {{ forum_post.createdAt|date('d/m/Y H:i') }}
                        {% if forum_post.updatedAt %}
                            | Dernière modification le {{ forum_post.updatedAt|date('d/m/Y H:i') }}
                        {% endif %}
                    </p>

                    <!-- Boutons pour le post -->
                    <div class="d-flex justify-content-start gap-2 mb-3">
                        <!-- Bouton Supprimer le post -->
                        <form action="{{ path('app_admin_forum_post_delete', {'id': forum_post.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce post ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ forum_post.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i> Supprimer le post
                            </button>
                        </form>

                        <!-- Bouton Commenter -->
                        <a href="{{ path('app_admin_forum_post_comment', {'id': forum_post.id}) }}" class="btn btn-primary btn-sm">
                            <i class="fas fa-comment"></i> Commenter
                        </a>
                    </div>

                    <!-- Liste des commentaires associés -->
                    <h6>Commentaires :</h6>
                    {% if forum_post.comments|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for comment in forum_post.comments %}
                                <li class="list-group-item">
                                    <p>{{ comment.content }}</p>
                                    <small class="text-muted">
                                        Posté par : {{ comment.user.firstName }} {{ comment.user.lastName }}
                                        le {{ comment.createdAt|date('d/m/Y H:i') }}
                                        {% if comment.updatedAt %}
                                            | Modifié le {{ comment.updatedAt|date('d/m/Y H:i') }}
                                        {% endif %}
                                    </small>

                                    <!-- Bouton Supprimer le commentaire -->
                                    <form action="{{ path('app_admin_forum_comment_delete', {'id': comment.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm mt-2">
                                            <i class="fas fa-trash"></i> Supprimer le commentaire
                                        </button>
                                    </form>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted">Aucun commentaire pour ce post.</p>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" role="alert">
                Aucun post trouvé.
            </div>
        {% endfor %}
    </div>
{% endblock %}