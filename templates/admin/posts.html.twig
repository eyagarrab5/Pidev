{% extends 'base2.html.twig' %}

{% block title %}Admin - Posts{% endblock %}

{% block body %}
<style>
    /* Conteneur des notifications */
    .notification-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 1000;
    }

    /* Style de chaque notification */
    .notification {
        background-color: #ffffff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 15px;
        margin-bottom: 10px;
        width: 300px;
        position: relative;
        animation: slideIn 0.5s ease-out;
    }

    /* Bouton de fermeture */
    .notification .close-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        cursor: pointer;
        font-size: 16px;
        color: #888;
    }

    .notification .close-btn:hover {
        color: #333;
    }

    /* Animation pour l'apparition des notifications */
    @keyframes slideIn {
        from {
            transform: translateX(100%);
        }
        to {
            transform: translateX(0);
        }
    }
</style>
    {% if not ajax_request %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery (optionnel, si vous utilisez AJAX) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <div class="container mt-4">
        <h1 class="text-center text-primary mb-4">Administration - Posts</h1>
        <!-- Section des statistiques -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Total des Posts</h5>
                        <p class="card-text display-4">{{ total_posts }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Total des Commentaires</h5>
                        <p class="card-text display-4">{{ total_comments }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Post le plus aimé</h5>
                        <p class="card-text">
                            {% if most_liked_post %}
                                {{ most_liked_post.title }} ({{ most_liked_post.likes }} likes)
                            {% else %}
                                Aucun post
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-danger mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Post le plus commenté</h5>
                        <p class="card-text">
                            {% if most_commented_post %}
                                {{ most_commented_post.title }} ({{ most_commented_post.commentsCount }} commentaires)
                            {% else %}
                                Aucun post
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>
        </div>

         <!-- Section des notifications -->
        <div class="notification-container">
            {% for forum_post in forum_posts %}
                {% for notification in forum_post.notifications %}
                    <div class="notification" data-notification-id="{{ loop.index }}">
                        <span>{{ notification.message }}</span>
                        <button class="btn-close close-btn" aria-label="Close" onclick="removeNotification(this)"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

       <!-- Formulaire de recherche -->
        <div class="row mb-4">
            <div class="col-md-6">
                <input type="text" id="searchInput" class="form-control" placeholder="Rechercher un post..." value="{{ app.request.query.get('search') }}">
            </div>
            <div class="col-md-6">
                <form action="{{ path('app_admin_forum_posts') }}" method="get" class="d-flex">
                    <select name="sort" class="form-select me-2" onchange="this.form.submit()">
                        <option value="newest" {% if app.request.query.get('sort') == 'newest' %}selected{% endif %}>Plus récent</option>
                        <option value="oldest" {% if app.request.query.get('sort') == 'oldest' %}selected{% endif %}>Plus ancien</option>
                        <option value="most_liked" {% if app.request.query.get('sort') == 'most_liked' %}selected{% endif %}>Plus aimés</option>
                        <option value="least_liked" {% if app.request.query.get('sort') == 'least_liked' %}selected{% endif %}>Moins aimés</option>
                    </select>
                </form>
            </div>
        </div>
 {% endif %}
        <!-- Tableau des posts -->
        <div id="postsContainer">
        <table class="table table-striped table-hover table-bordered shadow-sm">
            <thead class="thead-dark">
                <tr>
                    <th>Titre</th>
                    <th>Contenu</th>
                    <th>Auteur</th>
                    <th>Date de création</th>
                    <th>Dernière modification</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for forum_post in forum_posts %}
                    <tr>
                        <td>{{ forum_post.title }}</td>
                        <td>{{ forum_post.content }}</td>
                        <td>{{ forum_post.user.firstName }} {{ forum_post.user.lastName }}</td>
                        <td>{{ forum_post.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            {% if forum_post.updatedAt %}
                                {{ forum_post.updatedAt|date('d/m/Y H:i') }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>
                             <!-- Bouton Voir les commentaires -->
                        <button type="button" class="btn btn-info btn-sm" data-bs-toggle="collapse" data-bs-target="#comments-{{ forum_post.id }}">
                            <i class="fas fa-eye"></i>
                        </button>

                            <!-- Bouton Commenter -->
                            <a href="{{ path('app_admin_forum_post_comment', {'id': forum_post.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-comment"></i>
                            </a>


                            <!-- Bouton Supprimer le post -->
                            <form action="{{ path('app_admin_forum_post_delete', {'id': forum_post.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce post ?');" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ forum_post.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i> 
                                </button>
                            </form>
                        </td>
                    </tr>

                   <!-- Commentaires associés au post -->
                    <tr>
                        <td colspan="6" class="p-0">
                            <div class="collapse" id="comments-{{ forum_post.id }}">
                                <div class="p-3">
                                    <h6>Commentaires :</h6>
                                    {% if forum_post.comments|length > 0 %}
                                        <table class="table table-bordered table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Contenu</th>
                                                    <th>Auteur</th>
                                                    <th>Date de création</th>
                                                    <th>Dernière modification</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for comment in forum_post.comments %}
                                                    <tr>
                                                        <td>{{ comment.content }}</td>
                                                        <td>{{ comment.user.firstName }} {{ comment.user.lastName }}</td>
                                                        <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                                                        <td>
                                                            {% if comment.updatedAt %}
                                                                {{ comment.updatedAt|date('d/m/Y H:i') }}
                                                            {% else %}
                                                                -
                                                            {% endif %}
                                                        </td>
                                                        <td>
                                                            <!-- Bouton Supprimer le commentaire -->
                                                            <form action="{{ path('app_admin_forum_comment_delete', {'id': comment.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');" class="d-inline">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                                                <button type="submit" class="btn btn-danger btn-sm">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% else %}
                                        <p class="text-muted">Aucun commentaire pour ce post.</p>
                                    {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">
                        <div class="alert alert-info" role="alert">
                            Aucun post trouvé.
                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    <!-- Pagination -->
    <div class="navigation">
        {{ knp_pagination_render(forum_posts) }}
    </div>
        {% if not ajax_request %}
        </div> <!-- Fermer la div .container -->
    {% endif %}
     {% block javascripts %}
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            $(document).ready(function () {
                // Écouteur d'événement sur le champ de recherche
                $('#searchInput').on('input', function () {
                    const searchQuery = $(this).val(); // Récupère la valeur du champ de recherche

                    // Envoie une requête AJAX au serveur
                    $.ajax({
                        url: '{{ path('app_admin_forum_posts') }}', // URL de la route Symfony
                        method: 'GET',
                        data: { search: searchQuery }, // Envoie la requête de recherche
                        success: function (response) {
                            // Met à jour la liste des posts avec les résultats de la recherche
                            $('#postsContainer').html($(response).find('#postsContainer').html());
                        },
                        error: function (xhr, status, error) {
                            console.error('Erreur lors de la recherche :', error);
                        }
                    });
                });
            });
        </script>
        <script>
function removeNotification(button) {
    let notification = button.closest('.notification');
    if (notification) {
        notification.style.animation = "fadeOut 0.5s";
        setTimeout(() => notification.remove(), 500);
    }
}

// Ajout d'une animation de disparition
document.head.insertAdjacentHTML("beforeend", `
    <style>
        @keyframes fadeOut {
            from { opacity: 1; transform: translateX(0); }
            to { opacity: 0; transform: translateX(100%); }
        }
    </style>
`);
</script>

    {% endblock %}
{% endblock %}