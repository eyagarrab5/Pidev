<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        body {
            background-image: url('{{ asset('img/pic5.jpg') }}'); /* Définir le GIF comme arrière-plan */
            background-size: cover; /* Couvrir toute la zone */
            background-position: center; /* Centrer l'image */
            background-repeat: no-repeat; /* Ne pas répéter l'image */
        }
        /* Forcer la couleur de fond de la navbar */
        #header {
        background-color: #ffffff !important;
        }
    /* Forcer la couleur bleue sur le titre et le logo */
        .logo, 
        .logo h1, 
        .sitename {
        color: rgb(26, 28, 175)!important;
        }
        /* Forcer la couleur bleue sur les liens de navigation */
    #navmenu ul li a {
        color: #007bff !important; /* Bleu */
        font-weight: 500; /* Optionnel, pour bien voir le texte */
    }
    
    /* Pour le survol, toujours en bleu */
    #navmenu ul li a:hover,
    #navmenu ul li a:focus {
        color: #007bff !important;
    }

    /* Style pour la photo de profil dans la navbar */
    .user-profile img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }
    /* Si votre navbar a une marge ou un padding par défaut */
.navbar {
    margin-bottom: 0; /* Supprimer la marge inférieure */
    padding-bottom: 0; /* Supprimer le padding inférieur */
}

/* Si votre contenu a une marge ou un padding par défaut */
.content {
    margin-top: 0; /* Supprimer la marge supérieure */
    padding-top: 0; /* Supprimer le padding supérieur */
}

.logo img {
    width: 100px; /* Largeur */
    height: 100px; /* Hauteur (identique à la largeur) */
    object-fit: cover; /* Pour s'assurer que l'image remplit le carré */
}

@media (max-width: 768px) {
    .logo img {
        width: 150px; /* Taille réduite pour les écrans plus petits */
    }
}

@media (max-width: 480px) {
    .logo img {
        width: 100px; /* Taille encore plus petite pour les mobiles */
    }
}

/* Style pour la navigation */
.navmenu {
    float: right; /* Aligner la navigation à droite */
}
/* Supprimer ou réduire la marge et le padding de la navbar */
.header {
    margin-bottom: 0;
    padding-bottom: 0;
}

/* Supprimer ou réduire la marge et le padding du contenu principal */
.main {
    margin-top: 0;
    padding-top: 0;
}




/* Ajuster les marges des éléments de la liste de navigation */
.navmenu ul li {
    margin-left: 10px; /* Réduire l'espacement entre les éléments */
}
/* Style pour la liste de navigation */
.navmenu ul {
    list-style: none; /* Supprimer les puces */
    margin: 0;
    padding: 0;
    display: flex; /* Aligner les éléments horizontalement */
    align-items: center;
}

/* Style pour les éléments de la liste */
.navmenu ul li {
    margin-left: 20px; /* Espacement entre les éléments */
}

/* Style pour les liens de navigation */
.navmenu ul li a {
    color: #007bff; /* Couleur du texte */
    text-decoration: none; /* Supprimer le soulignement */
    font-weight: 500; /* Poids de la police */
}

/* Style pour le survol des liens */
.navmenu ul li a:hover {
    text-decoration: underline; /* Souligner au survol */
}
/* styles.css */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}



.navbar-image {
    height: 50px; /* Ajustez la taille selon vos besoins */
    border-radius: 50%; /* Pour un effet de cercle */
}

.profile-image {
    max-width: 100%;
    height: 50px;
    border-radius: 50%; /* Pour un effet de cercle */
}
/* Style pour la navbar */
.navbar {
    background-color: #ffffff;
    padding: 5px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    width: 100%;
}

/* Style pour le logo */
.logo {
    margin-right: auto;
}

/* Style pour la photo de profil */
.navbar-logo {
    margin-left: auto;
}

/* Style pour l'image de profil */
.navbar-image {
    height: 40px;
    width: 40px;
    border-radius: 50%;
}
    </style>

  <meta charset="utf-8">
