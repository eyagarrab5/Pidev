        <li><a class="dropdown-item" href="{{ path('profile_index') }}">Mon Profil</a></li>
        <li><a class="dropdown-item" href="{{ path('app_login') }}">Déconnexion</a></li>
    </ul>
</div>

    </div>

            <ul>
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('user_index') }}">Dashboard</a></li>
                {% endif %}
            </ul>
    </div>
            <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            
        </nav>
    </div>
</header>

  <main class="main">
    {% block body %}{% endblock %}
