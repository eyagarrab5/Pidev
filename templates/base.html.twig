</head>

<body class="index-page scrolled">
 <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="container-fluid container-xl d-flex align-items-center justify-content-between" style="padding: 0; margin: 0;">
        <!-- Logo à gauche -->
        <div class="logo">
            <img src="{{ asset('assetsFB/images/logos/covoitmob_logo.jpg') }}" alt="Logo CovoitMob">
        </div>

       <!-- Photo de profil avec menu déroulant -->
<div class="dropdown">
    <a class="nav-link dropdown-toggle" href="#" role="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
