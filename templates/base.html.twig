		<script>


			let lastScrollTop = 0;
const navbar = document.getElementById("navbar");

window.addEventListener("scroll", function () {
let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
const footer = document.getElementById("footer");

// Check if we're at the bottom of the page
if (scrollTop + window.innerHeight >= document.documentElement.scrollHeight - footer.offsetHeight) { // Force the navbar to show if we're near the footer

navbar.classList.add("navbar-visible");
return;
}

// Scroll direction logic
if (scrollTop > lastScrollTop) { // When scrolling down, hide the navbar

navbar.classList.add("navbar-hidden");
} else { // When scrolling up, show the navbar

navbar.classList.add("navbar-visible");
} lastScrollTop = scrollTop; // Update the last scroll position
});
		</script>



