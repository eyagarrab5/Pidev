{% extends 'base2.html.twig' %}

{% block title %}Statistiques des Réservations{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center text-primary mb-4">Statistiques des Réservations</h1>

        <!-- Tableau des statistiques -->
        <table class="table table-striped table-hover shadow-sm mb-4">
            <thead class="thead-dark">
                <tr>
                    <th>Date de Début</th>
                    <th>Nombre de Réservations</th>
                </tr>
            </thead>
            <tbody>
                {% for reservation in reservationsByDate %}
                    <tr>
                        <td>{{ reservation.date|date('d/m/Y') }}</td>
                        <td>{{ reservation.count }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="text-center text-muted">Aucune réservation trouvée.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <!-- Graphique -->
        <div class="chart-container">
            <canvas id="reservationsChart"></canvas>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('reservationsChart').getContext('2d');
            const reservationsByDate = {{ reservationsByDate|json_encode|raw }};

            const labels = reservationsByDate.map(reservation => reservation.date);
            const data = reservationsByDate.map(reservation => reservation.count);

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nombre de Réservations',
                        data: data,
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}