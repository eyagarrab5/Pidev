{% extends 'base2.html.twig' %}

{% block title %}Statistiques des Réservations
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<h1 class="text-center text-primary mb-4">Statistiques des Réservations</h1>

		<!-- Cartes de statistiques -->
		<div class="row mb-4">
			<div class="col-md-4">
				<div class="card bg-primary text-white shadow-sm">
					<div class="card-body">
						<h5 class="card-title">Total des Réservations</h5>
						<p class="card-text display-4">{{ reservationsByDate|length }}</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card bg-success text-white shadow-sm">
					<div class="card-body">
						<h5 class="card-title">Réservations Aujourd'hui</h5>
						<p class="card-text display-4">{{ reservationsToday }}</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card bg-warning text-white shadow-sm">
					<div class="card-body">
						<h5 class="card-title">Réservations Cette Semaine</h5>
						<p class="card-text display-4">{{ reservationsThisWeek }}</p>
					</div>
				</div>
			</div>
		</div>

		<!-- Tableau des statistiques -->
		<div class="card shadow-sm mb-4">
			<div class="card-header bg-dark text-white">
				<h5 class="card-title mb-0">Réservations par Date</h5>
			</div>
			<div class="card-body">
				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th>Date de Début</th>
							<th>Nombre de Réservations</th>
						</tr>
					</thead>
					<tbody>
						{% for reservation in reservationsByDate %}
							<tr>
								<td>{{ reservation.date|date('d/m/Y') }}</td>
								<td>{{ reservation.count }}</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="2" class="text-center text-muted">Aucune réservation trouvée.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Graphique -->
		<div class="card shadow-sm">
			<div class="card-header bg-dark text-white">
				<h5 class="card-title mb-0">Graphique des Réservations</h5>
			</div>
			<div class="card-body">
				<canvas id="reservationsChart"></canvas>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function () {
const ctx = document.getElementById('reservationsChart').getContext('2d');
const reservationsByDate = {{ reservationsByDate|json_encode|raw }};

const labels = reservationsByDate.map(reservation => reservation.date);
const data = reservationsByDate.map(reservation => reservation.count);

new Chart(ctx, {
type: 'bar',
data: {
labels: labels,
datasets: [
{
label: 'Nombre de Réservations',
data: data,
backgroundColor: 'rgba(54, 162, 235, 0.2)',
borderColor: 'rgba(54, 162, 235, 1)',
borderWidth: 1
}
]
},
options: {
scales: {
y: {
beginAtZero: true
}
}
}
});
});
	</script>
{% endblock %}
