{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau post{% endblock %}

{% block body %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <style>
        .unified-container {
            border: 1px solid #dee2e6; /* Bordure gris clair */
            border-radius: 10px;
            background-color: #ffffff; /* Fond blanc */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Ombre subtile */
            overflow: hidden; /* Pour éviter que les bords internes ne dépassent */
            padding: 20px; /* Espace intérieur */
        }

        .unified-container h1 {
            color: #0d6efd; /* Titre en bleu */
            margin-bottom: 20px; /* Espace sous le titre */
        }

        .img-container {
            border-right: 1px solid #dee2e6; /* Bordure entre l'image et le formulaire */
            padding: 10px;
            background-color: #f8f9fa; /* Fond gris très clair */
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%; /* Prend toute la hauteur disponible */
        }

        .img-container img {
            max-width: 100%; /* Largeur maximale de l'image */
            height: auto; /* Hauteur automatique pour conserver les proportions */
            border-radius: 10px;
            width: 600px; /* Largeur fixe pour agrandir l'image (ajustez cette valeur) */
        }

        .form-container {
            padding: 20px;
            background-color: #ffffff; /* Fond blanc */
            height: 100%; /* Prend toute la hauteur disponible */
        }

        .form-control {
            border-radius: 5px;
        }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
            transition: background-color 0.2s, border-color 0.2s;
        }

        .btn-primary:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            transition: background-color 0.2s, border-color 0.2s;
        }

        .btn-secondary:hover {
            background-color: #5c636a;
            border-color: #565e64;
        }
    </style>

    <div class="container">
        <!-- Conteneur unifié pour l'image et le formulaire -->
        <div class="unified-container">
            <h1 class="text-center">Créer un nouveau post</h1> <!-- Titre dans le cadre et en bleu -->
            <div class="row">
                <!-- Colonne de gauche pour l'image -->
                <div class="col-md-4">
                    <div class="img-container">
                        <img src="{{ asset('img/pic7.jpg') }}" alt="Image du forum" class="img-fluid">
                    </div>
                </div>

                <!-- Colonne de droite pour le formulaire -->
                <div class="col-md-8">
                    <div class="form-container">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        <div class="mb-3">
                            {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Entrez un titre'}}) }}
                            {{ form_errors(form.title) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.content, 'Contenu', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.content, {'attr': {'class': 'form-control', 'placeholder': 'Quoi de neuf ?', 'rows': 4}}) }}
                            {{ form_errors(form.content) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.category, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.category) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.tags, 'Tags', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.tags, {'attr': {'class': 'form-control', 'placeholder': 'Ajoutez des tags (séparés par des virgules)'}}) }}
                            {{ form_errors(form.tags) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.attachment, 'Pièces jointes', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.attachment, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.attachment) }}
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Publier
                            </button>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Bouton de retour -->
        <div class="mt-4">
            <a href="{{ path('app_forum_posts_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>
{% endblock %}