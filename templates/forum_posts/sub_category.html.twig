{% extends 'base.html.twig' %}

{% block title %}Forum - {{ category }} - {{ subCategory }}{% endblock %}

{% block body %}
    <h1>{{ category }} - {{ subCategory }}</h1>
    <ul>
        {% for post in forumPosts %}
            <li>
                <h2>{{ post.title }}</h2>
                <p>{{ post.content }}</p>
            </li>
        {% else %}
            <li>Aucun post trouvé pour cette sous-rubrique.</li>
        {% endfor %}
    </ul>

    <!-- Formulaire pour créer un nouveau post -->
    <h2>Créer un nouveau post</h2>
    <form action="{{ path('app_forum_create_post') }}" method="post">
        <div>
            <label for="title">Titre :</label>
            <input type="text" id="title" name="title" required>
        </div>
        <div>
            <label for="content">Contenu :</label>
            <textarea id="content" name="content" required></textarea>
        </div>
        <button type="submit">Publier</button>
    </form>
{% endblock %}