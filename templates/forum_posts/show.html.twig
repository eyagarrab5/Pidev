{% extends 'base.html.twig' %}

{% block title %}Détails du Post{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="text-center my-4">Détails du Post</h1>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">{{ forum_post.title }}</h5>
                <p class="card-text">{{ forum_post.content }}</p>
                <p class="text-muted small">
                    Posté le {{ forum_post.createdAt|date('d/m/Y H:i') }}
                    {% if forum_post.updatedAt %}
                        | Dernière modification le {{ forum_post.updatedAt|date('d/m/Y H:i') }}
                    {% endif %}
                </p>

                <!-- Afficher le nombre de commentaires -->
                <p><strong>Commentaires :</strong> {{ forum_post.commentsCount }}</p>
            </div>

            <!-- Section des Commentaires -->
            <div class="card-body">
                <h6>Commentaires :</h6>
                {% if forum_post.comments|length > 0 %}
                    <ul class="list-group list-group-flush">
                        {% for comment in forum_post.comments %}
                            <li class="list-group-item">
                                <p>{{ comment.content }}</p>
                                <small class="text-muted">
                                     Posté par : {{ comment.user.firstName }} {{ comment.user.lastName }}
                                    le {{ comment.createdAt|date('d/m/Y H:i') }}
                                    {% if comment.updatedAt %}
                                        | Modifié le {{ comment.updatedAt|date('d/m/Y H:i') }}
                                    {% endif %}
                                </small>
                                <div class="comment-actions">
            <a href="{{ path('app_comments_edit', {'id': comment.id}) }}" class="btn btn-modify">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <form action="{{ path('app_comments_delete', {'id': comment.id}) }}" method="post" class="form-delete">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                <button type="submit" class="btn btn-delete">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </form>
        </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted">Aucun commentaire pour le moment.</p>
                {% endif %}
                <form action="{{ path('app_comments_new', {'postId': forum_post.id}) }}" method="post" class="mt-3">

                            <button type="submit" class="btn btn-primary btn-sm mt-2">Commenter</button>
                        </form>
            </div>
        </div>

        <!-- Boutons de navigation -->
        <div class="mt-4">
            <a href="{{ path('app_forum_posts_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_forum_posts_edit', {'id': forum_post.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Modifier
            </a>
            {{ include('forum_posts/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}