            <i class="fas fa-car-side me-2"></i>Editer le nombre  de places disponibles
        </h6>
       
     <div class="mb-4">
            {{ form_widget(form.placesDispo, {'attr': {'class': 'form-control p-3 border-0 rounded-3 shadow-lg', 'style': 'box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);'}}) }}
