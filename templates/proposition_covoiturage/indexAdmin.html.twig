{% extends 'base2.html.twig' %}

{% block title %}PropositionCovoiturage index{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('styles/demande.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
    <h1 style="color: #0044cc; text-align: center;">Toutes les Propositions</h1>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id Proposition</th>
                <th>Id Conducteur </th>
                <th>palces</th>
                <th>Statut</th>
                <th>Id Demande</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for proposition_covoiturage in proposition_covoiturages %}
                <tr>
                <td >{{ proposition_covoiturage.id }}</td>
                <td >{{ proposition_covoiturage.conducteurid }}</td>
                <td >{{ proposition_covoiturage.placesDispo }}</td>
                <td >{{ proposition_covoiturage.statut.value }}</td>
                <td >{{ proposition_covoiturage.demande.id }}</td>
                 <td>
                    {{ include('proposition_covoiturage/_delete_form_Admin.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucune demande trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

{% endblock %}

















