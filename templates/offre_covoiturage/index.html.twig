{% extends 'base.html.twig' %}

{% block title %}Offres de Covoiturage{% endblock %}

{% block body %}
<div class="container" style="margin-top: -4.5rem !important;">
    <!-- Formulaire de recherche et filtre -->
    <div class="card shadow-lg mb-5 border-0 bg-light">
        <div class="card-body p-4">
            <form action="{{ path('app_offre_covoiturage_index') }}" method="get" class="row g-3 align-items-center">
                <div class="col-md-5 position-relative">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" 
                               name="search" 
                               class="form-control" 
                               placeholder="Départ ou destination..." 
                               value="{{ app.request.query.get('search') }}">
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="fas fa-calendar-alt text-muted"></i>
                        </span>
                        <input type="date" 
                               name="date" 
                               class="form-control" 
                               value="{{ app.request.query.get('date') }}">
                    </div>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-lg hover-scale">
                        <i class="fas fa-filter me-2"></i>Filtrer
                    </button>
                    <a href="{{ path('app_offre_covoiturage_index') }}" 
                       class="btn btn-light btn-lg border hover-scale" 
                       title="Réinitialiser">
                        <i class="fas fa-undo text-secondary"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Boutons de tri -->
    <div class="d-flex justify-content-end mb-4">
        <div class="btn-group shadow-sm rounded-pill overflow-hidden">
            {% set current_sort = current_sort|default({'field': 'prix', 'direction': 'asc'}) %}
            
            <a href="{{ path('app_offre_covoiturage_index', app.request.query.all|merge({'sort_by': 'prix', 'sort_order': (current_sort.field == 'prix' and current_sort.direction == 'asc') ? 'desc' : 'asc'})) }}" 
               class="btn btn-sort {{ current_sort.field == 'prix' ? 'active' : '' }}">
<i class="fas fa-coins me-2"></i>Prix                <i class="fas fa-sort-{{ current_sort.field == 'prix' ? current_sort.direction|lower : 'asc' }} ms-2"></i>
            </a>
            
            <a href="{{ path('app_offre_covoiturage_index', app.request.query.all|merge({'sort_by': 'placesDispo', 'sort_order': (current_sort.field == 'placesDispo' and current_sort.direction == 'asc') ? 'desc' : 'asc'})) }}" 
               class="btn btn-sort {{ current_sort.field == 'placesDispo' ? 'active' : '' }}">
                <i class="fas fa-users me-2"></i>Places
                <i class="fas fa-sort-{{ current_sort.field == 'placesDispo' ? current_sort.direction|lower : 'asc' }} ms-2"></i>
            </a>
        </div>
    </div>

    <!-- Contenu principal -->
    <div class="gif-container" style="margin-bottom: 39px;">
        <h2 style="text-align: center;font-family: 'Poppins', sans-serif;">Trouvez votre trajet idéal parmi les offres disponibles !</h2>
        <img src="{{ asset('img/gif2.gif') }}" alt="GIF animée" style="max-width: 300px; height: auto;border-radius: 5%;margin-bottom: -35px;margin-left: 509px;">
    </div>

    <div class="row">
        {% for offre_covoiturage in pagination %}
            <div class="col-md-4 mb-4">
                <div class="card custom-card shadow-lg" style="border: 20px solid #ecf4ff;">
                    <div class="card-body">
                        <h5 class="card-title">Mohammed 2</h5>
                        <h6 class="card-subtitle mb-2 text-muted">De {{ offre_covoiturage.depart }} à {{ offre_covoiturage.destination }}</h6>
                        <p>
                            <i class="fas fa-car" style="color: #007bff;"></i>
                            <strong>Matricule:</strong> {{ offre_covoiturage.matVehicule }}<br>
                            <i class="fas fa-users" style="color: #17a2b8;"></i>
                            <strong>Places Disponibles:</strong> {{ offre_covoiturage.placesDispo }}<br>
                            <i class="fas fa-calendar-alt" style="color: #007bff;"></i>
                            <strong>Date:</strong> {{ offre_covoiturage.date ? offre_covoiturage.date|date('Y-m-d H:i:s') : 'Non spécifiée' }}<br>
                            <i class="fas fa-wallet" style="color: #28a745;"></i>
                            <strong>Prix:</strong> {{ offre_covoiturage.prix }} dt<br>
                            <img src="{{ asset('uploads/' ~ offre_covoiturage.img) }}" 
                                 class="covoiturage-image">
                        </p>
                        <div class="d-flex justify-content-between">
                            <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#confirmationModal{{ offre_covoiturage.id }}">
                                Réserver
                            </button>
                            <button class="btn-favorite">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modale de confirmation -->
            <div class="modal fade" id="confirmationModal{{ offre_covoiturage.id }}" tabindex="-1" aria-labelledby="confirmationModalLabel{{ offre_covoiturage.id }}" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="confirmationModalLabel{{ offre_covoiturage.id }}">Confirmer la réservation</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <img src="{{ asset('img/confirmeReservation.jpg') }}" alt="Image de confirmation" class="img-fluid mb-3" style="border-radius: 8px; width: 200px; display: block; margin: 0 auto;">
                            Êtes-vous sûr de vouloir réserver ce trajet de {{ offre_covoiturage.depart }} à {{ offre_covoiturage.destination }} le {{ offre_covoiturage.date|date('Y-m-d H:i:s') }} ?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <a href="{{ path('app_reservation_new', {'id': offre_covoiturage.id}) }}" class="btn btn-primary">Confirmer</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center">
                <p class="text-danger">Aucune offre trouvée.</p>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    <div class="mt-5 d-flex justify-content-center">
        {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig', {
            'align': 'center',
            'size': 'large',
            'rounded': true,
        }) }}
    </div>
</div>

<style>
    body {
        background-image: url('{{ asset('img/pic5.jpg') }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .card.custom-card {
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;
        margin-top: 20px;
    }

    .card.custom-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    }

    .btn-custom {
        background-color: rgb(245 172 0);
        color: #333;
        font-size: 1rem;
        padding: 0.5rem 1rem;
        border-radius: 5px;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    .btn-custom:hover {
        background-color: #07005a;
        color: white;
    }

    /* Styles pour le tri */
    .btn-sort {
        background: #fff;
        color: #6c757d;
        border: 1px solid #dee2e6;
        padding: 0.75rem 1.5rem;
        transition: all 0.2s ease;
    }

    .btn-sort:hover {
        background: #f8f9fa;
        color: #0d6efd;
    }

    .btn-sort.active {
        background: #0d6efd !important;
        color: white !important;
        border-color: #0d6efd;
    }

    .hover-scale {
        transition: transform 0.2s ease;
    }

    .hover-scale:hover {
        transform: scale(1.05);
    }

    .btn-favorite {
        background-color: transparent;
        border: none;
        color: #dc3545;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 6px;
        transition: transform 0.3s ease, color 0.3s ease;
    }

    .btn-favorite i {
        font-size: 1.5rem;
        color: transparent;
        -webkit-text-stroke: 1px #dc3545;
        transition: color 0.3s ease, transform 0.3s ease;
    }

    .btn-favorite:hover i {
        color: rgba(255, 77, 77, 0.3);
        -webkit-text-stroke: 1px #fa4455;
        transform: scale(1.1);
    }

    .covoiturage-image {
        width: 339px;
        height: 277px;
        border-radius: 8px;
        margin-top: 10px;
    }

    .modal-backdrop.show {
        backdrop-filter: blur(8px);
    }
</style>
<!-- Bootstrap JS (si pas déjà inclus dans base.html.twig) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
