{% extends 'base.html.twig' %}

{% block title %}Offres de Covoiturage{% endblock %}

{% block body %}
    <div class="container" style="margin-top: -4.5rem !important;">
          <div class="search-container" style="text-align: center; margin-bottom: 20px;">
        <div class="input-group" style="max-width: 300px; margin: 0 auto;">
            <span class="input-group-text" style="background-color: #fff; border-right: 0;">
                <i class="fas fa-search" style="color: #007bff;"></i>
            </span>
            <input type="text" class="form-control" placeholder="Rechercher des demandes..." aria-label="Rechercher" style="border-left: 0;">
        </div>
    </div>
         <!-- Ajouter le GIF en haut de la page -->
        <div class="gif-container" style="margin-bottom: 39px;">
                <h2 style="text-align: center;font-family: 'Poppins', sans-serif;">Trouvez votre trajet idéal parmi les offres disponibles !</h2>

            <img src="{{ asset('img/gif2.gif') }}" alt="GIF animée" style="max-width: 300px; height: auto;border-radius: 5%;margin-bottom: -35px;margin-left: 509px;">
        </div>
        <div class="row">
            {% for offre_covoiturage in offre_covoiturages %}
                <div class="col-md-4 mb-4">
                    <div class="card custom-card shadow-lg" style="border: 20px solid #ecf4ff;">
                        <div class="card-body">
                            <h5 class="card-title">Mohammed 2</h5>
                            <h6 class="card-subtitle mb-2 text-muted">De {{ offre_covoiturage.depart }} à {{ offre_covoiturage.destination }}</h6>
                            <p>
                                <i class="fas fa-car" style="color: #007bff;"></i>
                                <strong>Matricule:</strong> {{ offre_covoiturage.matVehicule }}<br>
                                <i class="fas fa-users" style="color: #17a2b8;"></i>
                                <strong>Places Disponibles:</strong> {{ offre_covoiturage.placesDispo }}<br>
                                <i class="fas fa-calendar-alt" style="color: #007bff;"></i>
                                <strong>Date:</strong> {{ offre_covoiturage.date ? offre_covoiturage.date|date('Y-m-d H:i:s') : 'Non spécifiée' }}<br>
                                <i class="fas fa-wallet" style="color: #28a745;"></i>
                                <strong>Prix:</strong> {{ offre_covoiturage.prix }} dt<br>
                            </p>
                            <div class="d-flex justify-content-between">
                                <button class="btn btn-custom" data-bs-toggle="modal" data-bs-target="#confirmationModal{{ offre_covoiturage.id }}">
                                    Réserver
                                </button>
                                  <button class="btn-favorite">
                                  <i class="fas fa-heart"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modale de confirmation -->
                <div class="modal fade" id="confirmationModal{{ offre_covoiturage.id }}" tabindex="-1" aria-labelledby="confirmationModalLabel{{ offre_covoiturage.id }}" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="confirmationModalLabel{{ offre_covoiturage.id }}">Confirmer la réservation</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <img src="{{ asset('img/confirmeReservation.jpg') }}" alt="Image de confirmation" class="img-fluid mb-3" style="border-radius: 8px; width: 200px; display: block; margin: 0 auto;">
                                Êtes-vous sûr de vouloir réserver ce trajet de {{ offre_covoiturage.depart }} à {{ offre_covoiturage.destination }} le {{ offre_covoiturage.date|date('Y-m-d H:i:s') }} ?
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                <a href="{{ path('app_reservation_new', {'id': offre_covoiturage.id}) }}" class="btn btn-primary">Confirmer</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">
                    <p class="text-danger">Aucune offre trouvée.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% block javascripts %}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let confirmBtn = document.getElementById("confirmBtn");

        document.querySelectorAll(".btn-propose").forEach(button => {
            button.addEventListener("click", function () {
                let id = this.getAttribute("data-id");
                confirmBtn.href = "{{ path('app_reservation_new', {'id': '__ID__'}) }}".replace("__ID__", id);
                document.body.classList.add("modal-open"); 
            });
        });

        document.getElementById("confirmationModal").addEventListener("hidden.bs.modal", function () {
            document.body.classList.remove("modal-open");
        });
    });
</script>
{% endblock %}

<style>
    body {
        background-image: url('{{ asset('img/pic5.jpg') }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .card.custom-card {
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;
        margin-top: 20px;
    }

    .card.custom-card:hover {
        transform: translateY(-15px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    }

    .card-body {
        padding: 20px;
        background-color: #f8f9fa;
    }

    .btn-custom {
        background-color: rgb(245 172 0) ;
        color: #333;
        font-size: 1rem;
        padding: 0.5rem 1rem;
        border-radius: 5px;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

    .btn-custom:hover {
        background-color: #07005a;
        color: white;
    }

    .text-danger {
        font-weight: bold;
    }

    .bg-lightblue {
        background-color: #eef5ff;
    }

    /* Modal backdrop blur */
    .modal-backdrop.show {
        backdrop-filter: blur(8px);
    }
    
.btn-favorite {
    background-color: transparent; /* Fond transparent */
    border: none; /* Pas de bordure pour le bouton */
    color: #dc3545; /* Couleur de la bordure du cœur */
    font-size: 1.5rem;
    cursor: pointer;
    padding: 6px; /* Espace interne */
    transition: transform 0.3s ease, color 0.3s ease;
}

.btn-favorite i {
    font-size: 1.5rem;
    color: transparent; /* Cœur transparent */
    -webkit-text-stroke: 1px #dc3545; /* Bordure rouge */
    transition: color 0.3s ease, transform 0.3s ease;
}

.btn-favorite:hover i {
    color: rgba(255, 77, 77, 0.3); /* Remplissage léger au survol */
    -webkit-text-stroke: 1px #fa4455; /* Bordure plus vive */
    transform: scale(1.1); /* Légère mise en avant */
}

.btn-favorite:focus {
    outline: none;
}

</style>

<!-- Bootstrap JS (si pas déjà inclus dans base.html.twig) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
