{% extends 'base.html.twig' %}

{% block title %}Vehicule index{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <div class="container">
        <h1 class="text-center my-4">Nos Véhicules</h1>
        <!-- Champ de recherche dynamique -->
        <div class="mb-4">
            <label for="searchInput">Rechercher un véhicule :</label>
            <input type="text" id="searchInput" name="search" class="form-control" placeholder="Rechercher par modèle, type, etc.">
        </div>

        <!-- Menu déroulant pour le tri -->
        <!-- templates/vehicule/index.html.twig -->

<div class="mb-4">
    <form method="get" action="{{ path('app_vehicule_index') }}">
        <label for="sort_by">Trier par :</label>
        <select name="sort_by" id="sort_by" onchange="this.form.submit()" class="form-select">
            <option value="disponibilite_matin" {{ sort_by == 'disponibilite_matin' ? 'selected' : '' }}>Disponibilité (matin)</option>
            <option value="disponibilite_nuit" {{ sort_by == 'disponibilite_nuit' ? 'selected' : '' }}>Disponibilité (nuit)</option>
            <option value="id" {{ sort_by == 'id' ? 'selected' : '' }}>Par défaut</option>
        </select>
    </form>
</div>
   <div id="vehicules-list">
            <!-- Afficher les véhicules épinglés -->
            <div class="row">
                {% for vehicule in pinnedVehicules %}
                    <div class="col-md-4">
                        <div class="card mb-4 border-white">
                            {% if vehicule.image %}
                                <img src="{{ asset('uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Image du véhicule">
                            {% else %}
                                <img src="{{ asset('assets/uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Bakomotors">
                            {% endif %}
                            <div class="card-body text-center">
                                <h5 class="card-title">{{ vehicule.typeVehicule }} - {{ vehicule.modele }}</h5>
                                <p class="card-text"><strong>Rôle :</strong> {{ vehicule.role }}</p>
                                <p class="card-text"><strong>Prix par heure :</strong> {{ vehicule.prixParHeure }}TND</p>
                                <p class="card-text"><strong>Prix par jour :</strong> {{ vehicule.prixParJour }}TND </p>
                                <p class="card-text"><strong>Disponibilité :</strong> {{ vehicule.disponibilite }}</p>
                                <p class="card-text"><strong>Lieu de retrait :</strong> {{ vehicule.lieuRetrait }}</p>
                                <div class="actions">
                                    <a href="{{ path('app_res_new', { 'vehiculeId': vehicule.id }) }}" class="btn btn-primary">Reserver Vehicule</a>
                                    <a href="{{ path('app_vehicule_pdf', {'id': vehicule.id}) }}" 
                                       style="background-color:white; color: #ff0000; padding: 5px 10px; margin-left: 250px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                        <i class="fas fa-file-pdf"></i> 
                                    </a>
                                    <!-- Bouton pour épingler/désépingler -->
<form action="{{ path('app_vehicule_pin', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
    <button type="submit" class="btn btn-sm {{ vehicule.isPinned ? 'btn-outline-danger' : 'btn-outline-secondary' }}">
        <i class="fas fa-thumbtack"></i> {{ vehicule.isPinned ? 'Désépingler' : 'Épingler' }}
    </button>
</form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Afficher les autres véhicules -->
            <div class="row">
                {% for vehicule in vehicules %}
                    <div class="col-md-4">
                        <div class="card mb-4 border-white">
                            {% if vehicule.image %}
                                <img src="{{ asset('uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Image du véhicule">
                            {% else %}
                                <img src="{{ asset('assets/uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Bakomotors">
                            {% endif %}
                            <div class="card-body text-center">
                                <h5 class="card-title">{{ vehicule.typeVehicule }} - {{ vehicule.modele }}</h5>
                                <p class="card-text"><strong>Rôle :</strong> {{ vehicule.role }}</p>
                                <p class="card-text"><strong>Prix par heure :</strong> {{ vehicule.prixParHeure }}TND</p>
                                <p class="card-text"><strong>Prix par jour :</strong> {{ vehicule.prixParJour }}TND </p>
                                <p class="card-text"><strong>Disponibilité :</strong> {{ vehicule.disponibilite }}</p>
                                <p class="card-text"><strong>Lieu de retrait :</strong> {{ vehicule.lieuRetrait }}</p>
                                <div class="actions">
                                    <a href="{{ path('app_res_new', { 'vehiculeId': vehicule.id }) }}" class="btn btn-primary">Reserver Vehicule</a>
                                    <a href="{{ path('app_vehicule_pdf', {'id': vehicule.id}) }}" 
                                       style="background-color:white; color: #ff0000; padding: 5px 10px; margin-left: 250px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                        <i class="fas fa-file-pdf"></i> 
                                    </a>
                                    <!-- Bouton pour épingler/désépingler -->
                                    <form action="{{ path('app_vehicule_pin', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm {{ vehicule.isPinned ? 'btn-outline-danger' : 'btn-outline-secondary' }}">
                                            <i class="fas fa-thumbtack"></i> {{ vehicule.isPinned  }}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center">Aucun véhicule trouvé.</p>
                {% endfor %}
            </div>
        </div>
      <!-- Pagination -->
        <div class="navigation">
    <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(vehicules) }}
</div>

</div>
    </div>
    
    {% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
       $(document).ready(function () {
    $('#searchInput').on('input', function () {
        const searchQuery = $(this).val(); // Récupère la valeur du champ de recherche

        // Envoie une requête AJAX au serveur
        $.ajax({
            url: '{{ path('app_vehicule_search') }}', // Utilisez la route dédiée à la recherche
            method: 'GET',
            data: { q: searchQuery }, // Envoie la requête de recherche
            success: function (response) {
                // Met à jour la liste des véhicules avec les résultats de la recherche
                $('#vehicules-list').html(response);
            },
            error: function (xhr, status, error) {
                console.error('Erreur lors de la recherche :', error);
            }
        });
    });
});
    </script>
{% endblock %}
{% endblock %}

{% block stylesheet%}
body {
        background-image: url('{{ asset('img/img2.png') }}'); /* Définir le GIF comme arrière-plan */
        background-size: cover; /* Couvrir toute la zone */
        background-position: center; /* Centrer l'image */
        background-repeat: no-repeat; /* Ne pas répéter l'image */
    }
{% endblock %}

