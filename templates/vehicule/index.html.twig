{% extends 'base.html.twig' %}

{% block title %}Vehicule index{% endblock %}

{% block body %}
<style>
/* public/css/styles.css */
body {
    background-image: url('{{ asset('img/pic5.jpg') }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    font-family: Arial, sans-serif;
    color: #333;
    margin: 0;
    padding: 0;
}
.btn-outline-success {
    color: #28a745;
    border-color: #28a745;
}

.btn-outline-success:hover {
    background-color: #28a745;
    color: white;
}

.btn-outline-danger {
    color: #dc3545;
    border-color: #dc3545;
}

.btn-outline-danger:hover {
    background-color: #dc3545;
    color: white;
}
      .card {
    transition: transform 0.3s ease; /* Transition fluide */
    border-radius: 10px; /* Ajoute des coins arrondis pour un meilleur effet */
}

.card:hover {
    transform: translateY(-10px); /* Glissement vers le haut au survol */
}
</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <div class="container">
        <h1 class="text-center my-4">Nos Véhicules</h1>
        <!-- Champ de recherche dynamique -->
        <div class="mb-4">
            <label for="searchInput">Rechercher un véhicule :</label>
            <input type="text" id="searchInput" name="search" class="form-control" placeholder="Rechercher par modèle, type, etc." value="{{ app.request.query.get('q') }}">
        </div>

        <!-- Menu déroulant pour le tri -->
        <!-- templates/vehicule/index.html.twig -->

<div class="mb-4">
    <form method="get" action="{{ path('app_vehicule_index') }}">
        <label for="sort_by">Trier par :</label>
        <select name="sort_by" id="sort_by" onchange="this.form.submit()" class="form-select">
            <option value="disponibilite_matin" {{ sort_by == 'disponibilite_matin' ? 'selected' : '' }}>Disponibilité (matin)</option>
            <option value="disponibilite_nuit" {{ sort_by == 'disponibilite_nuit' ? 'selected' : '' }}>Disponibilité (nuit)</option>
            <option value="id" {{ sort_by == 'id' ? 'selected' : '' }}>Par défaut</option>
        </select>
    </form>
</div>
   <div id="vehicules-list">
            <!-- Afficher les véhicules épinglés -->
            <div class="row">
                {% for vehicule in pinnedVehicules %}
                    <div class="col-md-4">
                        <div class="card mb-4 border-white">
                            {% if vehicule.image %}
                                <img src="{{ asset('uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Image du véhicule">
                            {% else %}
                                <img src="{{ asset('assets/uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Bakomotors">
                            {% endif %}
                            <div class="card-body text-center">
                                <h5 class="card-title">{{ vehicule.typeVehicule }} - {{ vehicule.modele }}</h5>
                                <p class="card-text"><strong>Rôle :</strong> {{ vehicule.role }}</p>
                                <p class="card-text"><strong>Prix par heure :</strong> {{ vehicule.prixParHeure }}TND</p>
                                <p class="card-text"><strong>Prix par jour :</strong> {{ vehicule.prixParJour }}TND </p>
                                <p class="card-text"><strong>Disponibilité :</strong> {{ vehicule.disponibilite }}</p>
                                <p class="card-text"><strong>Lieu de retrait :</strong> {{ vehicule.lieuRetrait }}</p>
                                <div class="actions">
                                    <a href="{{ path('app_res_new', { 'vehiculeId': vehicule.id }) }}" class="btn btn-primary">Reserver Vehicule</a>
                                    <a href="{{ path('app_vehicule_pdf', {'id': vehicule.id}) }}" 
                                       style="background-color:white; color: #ff0000; padding: 5px 10px; margin-left: 250px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                        <i class="fas fa-file-pdf"></i> 
                                    </a>
                                    <!-- Bouton pour épingler/désépingler -->
                                    <form action="{{ path('app_vehicule_pin', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm {{ vehicule.isPinned ? 'btn-outline-danger' : 'btn-outline-secondary' }}">
                                            <i class="fas fa-thumbtack"></i> {{ vehicule.isPinned ? 'Désépingler' : 'Épingler' }}
                                        </button>
                                    </form>
                                    <!-- Boutons Like et Dislike -->
                                    <form action="{{ path('app_vehicule_like', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('like' ~ vehicule.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-success like-btn" data-vehicule-id="{{ vehicule.id }}">
                                            <i class="fas fa-thumbs-up"></i> Like (<span id="likes-count-{{ vehicule.id }}">{{ vehicule.likes }}</span>)
                                        </button>
                                    </form>

                                    <!-- Bouton Dislike -->
                                    <form action="{{ path('app_vehicule_dislike', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('dislike' ~ vehicule.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger dislike-btn" data-vehicule-id="{{ vehicule.id }}">
                                            <i class="fas fa-thumbs-down"></i> Dislike (<span id="dislikes-count-{{ vehicule.id }}">{{ vehicule.dislikes }}</span>)
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Afficher les autres véhicules -->
            <div class="row">
                {% for vehicule in vehicules %}
                    <div class="col-md-4">
                        <div class="card mb-4 border-white">
                            {% if vehicule.image %}
                                <img src="{{ asset('uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Image du véhicule">
                            {% else %}
                                <img src="{{ asset('assets/uploads/vehicules/' ~ vehicule.image) }}" class="card-img-top" alt="Bakomotors">
                            {% endif %}
                            <div class="card-body text-center">
                                <h5 class="card-title">{{ vehicule.typeVehicule }} - {{ vehicule.modele }}</h5>
                                <p class="card-text"><strong>Rôle :</strong> {{ vehicule.role }}</p>
                                <p class="card-text"><strong>Prix par heure :</strong> {{ vehicule.prixParHeure }}TND</p>
                                <p class="card-text"><strong>Prix par jour :</strong> {{ vehicule.prixParJour }}TND </p>
                                <p class="card-text"><strong>Disponibilité :</strong> {{ vehicule.disponibilite }}</p>
                                <p class="card-text"><strong>Lieu de retrait :</strong> {{ vehicule.lieuRetrait }}</p>
                                <div class="actions">
                                    <a href="{{ path('app_res_new', { 'vehiculeId': vehicule.id }) }}" class="btn btn-primary">Reserver Vehicule</a>
                                    <a href="{{ path('app_vehicule_pdf', {'id': vehicule.id}) }}" 
                                       style="background-color:white; color: #ff0000; padding: 5px 10px; margin-left: 250px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                        <i class="fas fa-file-pdf"></i> 
                                    </a>
                                    <!-- Bouton pour épingler/désépingler -->
                                    <form action="{{ path('app_vehicule_pin', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm {{ vehicule.isPinned ? 'btn-outline-danger' : 'btn-outline-secondary' }}">
                                            <i class="fas fa-thumbtack"></i> {{ vehicule.isPinned  }}
                                        </button>
                                    </form>
                                    <!-- Boutons Like et Dislike -->
                                   <form action="{{ path('app_vehicule_like', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('like' ~ vehicule.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-success like-btn" data-vehicule-id="{{ vehicule.id }}">
                                            <i class="fas fa-thumbs-up"></i> Like (<span id="likes-count-{{ vehicule.id }}">{{ vehicule.likes }}</span>)
                                        </button>
                                    </form>

                                    <!-- Bouton Dislike -->
                                    <form action="{{ path('app_vehicule_dislike', {'id': vehicule.id}) }}" method="POST" style="display: inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('dislike' ~ vehicule.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger dislike-btn" data-vehicule-id="{{ vehicule.id }}">
                                            <i class="fas fa-thumbs-down"></i> Dislike (<span id="dislikes-count-{{ vehicule.id }}">{{ vehicule.dislikes }}</span>)
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-center">Aucun véhicule trouvé.</p>
                {% endfor %}
            </div>
        </div>
      <!-- Pagination -->
        <div class="navigation">
    <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(vehicules,'@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
</div>

</div>
    </div>
<script>
   document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');

    searchInput.addEventListener('input', function () {
        const searchQuery = this.value;

        fetch(`{{ path('app_vehicule_index') }}?q=${searchQuery}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
            },
        })
        .then(response => response.json())
        .then(data => {
            const vehiculesList = document.getElementById('vehicules-list');
            vehiculesList.innerHTML = ''; // Vider la liste actuelle

            // Afficher les véhicules épinglés
            data.pinnedVehicules.forEach(vehicule => {
                vehiculesList.innerHTML += `
                    <div class="col-md-4">
                        <div class="card mb-4 border-white">
                            ${vehicule.image ? `<img src="{{ asset('uploads/vehicules/') }}${vehicule.image}" class="card-img-top" alt="Image du véhicule">` : `<img src="{{ asset('assets/uploads/vehicules/') }}${vehicule.image}" class="card-img-top" alt="Bakomotors">`}
                            <div class="card-body text-center">
                                <h5 class="card-title">${vehicule.typeVehicule} - ${vehicule.modele}</h5>
                                <p class="card-text"><strong>Rôle :</strong> ${vehicule.role}</p>
                                <p class="card-text"><strong>Prix par heure :</strong> ${vehicule.prixParHeure}TND</p>
                                <p class="card-text"><strong>Prix par jour :</strong> ${vehicule.prixParJour}TND</p>
                                <p class="card-text"><strong>Disponibilité :</strong> ${vehicule.disponibilite}</p>
                                <p class="card-text"><strong>Lieu de retrait :</strong> ${vehicule.lieuRetrait}</p>
                                <div class="actions">
                                    <a href="{{ path('app_res_new', { 'vehiculeId': '${vehicule.id}' }) }}" class="btn btn-primary">Reserver Vehicule</a>
                                    <a href="{{ path('app_vehicule_pdf', {'id': '${vehicule.id}' }) }}" 
                                       style="background-color:white; color: #ff0000; padding: 5px 10px; margin-left: 250px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                        <i class="fas fa-file-pdf"></i> 
                                    </a>
                                    <!-- Bouton pour épingler/désépingler -->
                                    <form action="{{ path('app_vehicule_pin', {'id': '${vehicule.id}' }) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm ${vehicule.isPinned ? 'btn-outline-danger' : 'btn-outline-secondary'}">
                                            <i class="fas fa-thumbtack"></i> ${vehicule.isPinned ? 'Désépingler' : 'Épingler'}
                                        </button>
                                    </form>
                                    <!-- Boutons Like et Dislike -->
                                    <form action="{{ path('app_vehicule_like', {'id': '${vehicule.id}' }) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-thumbs-up"></i> Like (${vehicule.likes})
                                        </button>
                                    </form>
                                    <form action="{{ path('app_vehicule_dislike', {'id': '${vehicule.id}' }) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-thumbs-down"></i> Dislike (${vehicule.dislikes})
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            // Afficher les autres véhicules
            data.vehicules.forEach(vehicule => {
                vehiculesList.innerHTML += `
                    <div class="col-md-4">
                        <div class="card mb-4 border-white">
                            ${vehicule.image ? `<img src="{{ asset('uploads/vehicules/') }}${vehicule.image}" class="card-img-top" alt="Image du véhicule">` : `<img src="{{ asset('assets/uploads/vehicules/') }}${vehicule.image}" class="card-img-top" alt="Bakomotors">`}
                            <div class="card-body text-center">
                                <h5 class="card-title">${vehicule.typeVehicule} - ${vehicule.modele}</h5>
                                <p class="card-text"><strong>Rôle :</strong> ${vehicule.role}</p>
                                <p class="card-text"><strong>Prix par heure :</strong> ${vehicule.prixParHeure}TND</p>
                                <p class="card-text"><strong>Prix par jour :</strong> ${vehicule.prixParJour}TND</p>
                                <p class="card-text"><strong>Disponibilité :</strong> ${vehicule.disponibilite}</p>
                                <p class="card-text"><strong>Lieu de retrait :</strong> ${vehicule.lieuRetrait}</p>
                                <div class="actions">
                                    <a href="{{ path('app_res_new', { 'vehiculeId': '${vehicule.id}' }) }}" class="btn btn-primary">Reserver Vehicule</a>
                                    <a href="{{ path('app_vehicule_pdf', {'id': '${vehicule.id}' }) }}" 
                                       style="background-color:white; color: #ff0000; padding: 5px 10px; margin-left: 250px; border-radius: 4px; text-decoration: none; display: inline-block;">
                                        <i class="fas fa-file-pdf"></i> 
                                    </a>
                                    <!-- Bouton pour épingler/désépingler -->
                                    <form action="{{ path('app_vehicule_pin', {'id': '${vehicule.id}' }) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm ${vehicule.isPinned ? 'btn-outline-danger' : 'btn-outline-secondary'}">
                                            <i class="fas fa-thumbtack"></i> ${vehicule.isPinned}
                                        </button>
                                    </form>
                                    <!-- Boutons Like et Dislike -->
                                    <form action="{{ path('app_vehicule_like', {'id': '${vehicule.id}' }) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-thumbs-up"></i> Like (${vehicule.likes})
                                        </button>
                                    </form>
                                    <form action="{{ path('app_vehicule_dislike', {'id': '${vehicule.id}' }) }}" method="POST" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-thumbs-down"></i> Dislike (${vehicule.dislikes})
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        })
        .catch(error => console.error('Erreur lors de la recherche :', error));
    });
});
    </script>
    <script>
      function removeNotification(button) {
        let notification = button.closest('.notification');
        if (notification) {
            notification.style.animation = "fadeOut 0.5s";
            setTimeout(() => notification.remove(), 500);
        }
    }

    document.head.insertAdjacentHTML("beforeend", `
        <style>
            @keyframes fadeOut {
                from { opacity: 1; transform: translateX(0); }
                to { opacity: 0; transform: translateX(100%); }
            }
        </style>
    `);
    </script>
        <script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
    $(document).ready(function () {
        // Gestion du bouton "Like"
        $('.like-btn').on('click', function (e) {
            e.preventDefault(); // Empêche la soumission du formulaire

            const $btn = $(this); // Référence au bouton cliqué
            const vehiculeId = $btn.data('vehicule-id'); // Récupère l'ID du véhicule
            const url = "{{ path('app_vehicule_like', {'id': 'VEHICULE_ID'}) }}".replace('VEHICULE_ID', vehiculeId);
            const token = $btn.closest('form').find('input[name="_token"]').val(); // Récupère le token CSRF

            // Envoie une requête AJAX
            $.ajax({
                url: url,
                method: 'POST',
                data: {
                    _token: token,
                },
                success: function (response) {
                    // Met à jour le nombre de likes affiché
                    $(`#likes-count-${vehiculeId}`).text(response.likes + " Likes");
                },
                error: function (xhr, status, error) {
                    console.error('Erreur lors du like :', error);
                }
            });
        });

        // Gestion du bouton "Dislike"
        $('.dislike-btn').on('click', function (e) {
            e.preventDefault(); // Empêche la soumission du formulaire

            const $btn = $(this); // Référence au bouton cliqué
            const vehiculeId = $btn.data('vehicule-id'); // Récupère l'ID du véhicule
            const url = "{{ path('app_vehicule_dislike', {'id': 'VEHICULE_ID'}) }}".replace('VEHICULE_ID', vehiculeId);
            const token = $btn.closest('form').find('input[name="_token"]').val(); // Récupère le token CSRF

            // Envoie une requête AJAX
            $.ajax({
                url: url,
                method: 'POST',
                data: {
                    _token: token,
                },
                success: function (response) {
                    // Met à jour le nombre de dislikes affiché
                    $(`#dislikes-count-${vehiculeId}`).text(response.dislikes + " Dislikes");
                },
                error: function (xhr, status, error) {
                    console.error('Erreur lors du dislike :', error);
                }
            });
        });
    });
</script>
{% endblock %}

